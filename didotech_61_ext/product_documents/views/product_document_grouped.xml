<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <record id="product_document_grouped_tree_view" model="ir.ui.view">
            <field name="name">product.document.grouped.tree.view</field>
            <field name="model">product.document.grouped</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="year"/>
                    <field name="document_type" />
                    <field name="state"/>
                    <field name="partner_id" invisible="context.get('hide_partner', False)"/>
                    <field name="name"/>
                    <field name="document_date" />
                    <field name="product_id" invisible="context.get('hide_product', False)"/>
                    <field name="qty" />
                    <field name="uom" />
                    <field name="price_unit" />
                    <field name="discount" />
                    <field name="price_unit_discount" />
                </tree>
            </field>
        </record>

        <record id="product_document_grouped_search_view" model="ir.ui.view">
            <field name="name">product.document.grouped.search.view</field>
            <field name="model">product.document.grouped</field>
            <field name="type">search</field>
            <field name="arch" type="xml">
                <search string="Search All Product">
                    <field name="document_type" />
                    <field name="partner_id" context="{'hide_partner': True}" invisible="context.get('hide_partner', False)"/>
                    <field name="product_id" context="{'hide_product': True}" invisible="context.get('hide_product', False)"/>
                    <field name="year" />
                    <separator orientation="vertical"/>
                    <field name="date_from" filter_domain="[('document_date','&gt;=',self)]"/>
                    <field name="date_to" filter_domain="[('document_date','&lt;=',self)]"/>
                    <separator orientation="vertical"/>
                    <newline/>
                    <group expand="1" string="Raggruppa per" groups="base.group_extended">
                        <filter name="document" string="Tipo Documento" icon="terp-personal" domain="[]" context="{'group_by': ['document_type']}"/>
                        <filter string="Partner" icon="terp-personal" domain="[]" context="{'group_by': ['partner_id']}"/>
                        <separator orientation="vertical"/>
                        <filter string="Data Documento" icon="terp-go-month" domain="[]" context="{'group_by': ['document_date']}"/>
                    </group>
                </search>
            </field>
        </record>

        <act_window
                id="action_view_sale_partner_history"
                name="Movimenti Storici"
                res_model="product.document.grouped"
                src_model="res.partner"
                view_mode="tree"
                domain="[('partner_id', '=', active_id)]"
                context="{'group_by': ['document_type'], 'nocreate': '1', 'nodelete': '1', 'noduplicate': '1', 'search_default_document': True, 'search_default_year': time.strftime('%Y'), 'search_default_partner_id': [active_id], 'hide_partner': True} "
        />

        <act_window
                id="action_view_product_product_history"
                name="Movimenti Storici"
                res_model="product.document.grouped"
                src_model="product.product"
                view_mode="tree"
                domain="[('product_id', '=', active_id)]"
                context="{'group_by': ['document_type'], 'nocreate': '1', 'nodelete': '1', 'noduplicate': '1', 'search_default_document': True, 'search_default_year': time.strftime('%Y'), 'search_default_product_id': [active_id], 'hide_product': True} "
        />

        
    </data>
</openerp>
