<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>

        <record id="view_account_config_settings" model="ir.ui.view">
            <field name="name">view_account_config_settings</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="l10n_it_fatturapa.view_account_config_settings"/>
            <field name="arch" type="xml">
                <group name="fatturapa_settings" position="after">
                    <group string="Attachments" colspan="2" col="2">
                        <field name="fatturapa_doc_attachments" nolabel="1">
                            <tree string="Attachments">
                                <field name="ir_attachment_id"/>
                                <field name="name"/>
                                <field name="description"/>
                                <field name="invoice_id"/>
                            </tree>
                            <form string="Attachments">
                                <group>
                                    <group>
                                        <field name="name"/>
                                        <field name="description"/>
                                    </group>
                                    <group>
                                        <field name="ir_attachment_id"/>
                                        <field name="invoice_id"/>
                                    </group>
                                </group>
                            </form>
                        </field>
                    </group>
                </group>

            </field>
        </record>

    </data>
</openerp>
