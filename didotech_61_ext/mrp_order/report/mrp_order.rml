    <images/>
  </stylesheet>
  <story>
    <para style="terp_default_8">[[repeatIn(objects,'o')]] </para>
    <para style="terp_default_8">
      <font color="white"> </font>
    </para>
    <blockTable colWidths="331.0,196.0" style="Tabella1">
      <tr>
        <td>
          <para style="terp_header_Right">Manufacturing Order N° : [[ o.name ]] </para>
        </td>
        <td>
          <barCode code="Code128" barHeight="25.0" barWidth="0.8">[[ o.name or False ]]</barCode>
        </td>
      </tr>

      <tr>
        <td>
            <para style="terp_header_Right">User : [[ o.user_id.name or removeParentNode('tr') ]] </para>

        </td>
        <td>
          <barCode code="Code128" barHeight="20.0" barWidth="0.8">[[ 'user_id' in o._columns.keys() and o.user_id.name or '' ]]</barCode>
        </td>
      </tr>

    </blockTable>
    <para style="terp_default_8">
      <font color="white"> </font>
    </para>
    <blockTable colWidths="160.0,262.0,106.0"  style="Table3">
      <tr>
        <td>
          <para style="P1">Customer</para>
        </td>
        <td>
          <para style="P1">Product </para>
        </td>
        <td>
          <para style="P1">Quantity</para>
        </td>
      </tr>
    </blockTable>
    <blockTable colWidths="160.0,262.0,106.0"  style="Table5">
      <tr>
        <td>
          <para style="terp_header">[[ ('sale_id' in o._columns.keys() and o.sale_id.partner_id.name) or '' ]]</para>
        </td>
        <td>
          <para style="P1">[[ (o.product_id and o.product_id.code) or '' ]] [[ (o.product_id and o.product_id.name) or '' ]]</para>
          <para style="P2">[[ (o.product_id and o.product_id.name) or '' ]]</para>
        </td>
        <td>
          <para style="terp_header">[[formatLang(o.product_qty) ]] [[ (o.product_id and o.product_uom and o.product_uom.name) or '']]</para>
        </td>
      </tr>
    </blockTable>
    <para style="terp_default_8">
      <font color="white"> </font>
    </para>
    <blockTable colWidths="59.0,59.0,304.0,106.0" repeatRows="1" style="Table1">
      <tr>
        <td>
          <para style="P1">Scheduled Date</para>
        </td>
        <td>
          <para style="P1">Printing date</para>
        </td>
        <td>
          <para style="P1">Partner Ref</para>
        </td>
        <td>
          <para style="P1">SO Number</para>
        </td>
      </tr>
    </blockTable>
    <section>
      <blockTable colWidths="59.0,59.0,304.0,106.0" style="Table2">
        <tr>
          <td>
            <para style="terp_default_Centre_8">[[ formatLang(o.date_planned, date_time = True)[0:10] ]]</para>
          </td>
          <td>
            <para style="terp_default_Centre_8">[[ formatLang(time.strftime('%Y-%m-%d'),date = True) ]]</para>
          </td>
          <td>
            <para style="terp_default_Centre_8">[[ ('sale_id' in o._columns.keys() and o.sale_id.client_order_ref) or '' ]]</para>
          </td>
          <td>
            <para style="terp_header">[[ ('sale_id' in o._columns.keys() and o.sale_id.name) or '' ]]</para>
          </td>
        </tr>
      </blockTable>
    </section>
    <para style="terp_default_Bold_8_backColor">Operation Barcode [[ o.workcenter_lines ==[] and removeParentNode('para')]]</para>
    <blockTable colWidths="132.0,132.0,132.0,132.0" style="Table3">
      <tr>
        <td>
            <barCode code="Code128" barHeight="25.0" barWidth="0.8">[[ 'OSTART' ]]</barCode>
            <para style="P2">START</para>
        </td>
        <td>
            <barCode code="Code128" barHeight="25.0" barWidth="0.8">[[ 'OSUSPEND' ]]</barCode>
            <para style="P2">SUSPEND</para>
        </td>
        <td>
            <barCode code="Code128" barHeight="25.0" barWidth="0.8">[[ 'ORESUME' ]]</barCode>
            <para style="P2">RESUME</para>
        </td>
        <td>
            <barCode code="Code128" barHeight="25.0" barWidth="0.8">[[ 'OSTOP' ]]</barCode>
            <para style="P2">STOP</para>
        </td>
      </tr>
    </blockTable>

    <para style="terp_default_Bold_8_backColor">
      <font color="white"> </font>
    </para>
    <para style="terp_default_Bold_8_backColor">Work Orders [[ o.workcenter_lines ==[] and removeParentNode('para')]]</para>
    <para style="terp_default_Bold_8_backColor">
      <font color="white"> </font>
    </para>
    <blockTable colWidths="82.0,198.0,142.0,53.0,53.0" style="Table6">
      <tr>
        <td>
          <para style="terp_tblheader_General_Centre">Sequence</para>
        </td>
        <td>
          <para style="terp_tblheader_Details_Centre">WorkCenter [[ o.workcenter_lines ==[] and removeParentNode('blockTable')]]</para>
        </td>
        <td>
          <para style="P3">Operation</para>
        </td>
        <td>
          <para style="terp_tblheader_General_Centre">No. Of Cycles</para>
        </td>
        <td>
          <para style="terp_tblheader_General_Centre">No. Of Hours</para>
        </td>
      </tr>
    </blockTable>
    <section>
      <para style="terp_default_8">[[ repeatIn(o.workcenter_lines,'line2') ]]</para>
      <blockTable colWidths="82.0,198.0,142.0,53.0,53.0" style="Table4">
        <tr>
          <td>
            <para style="terp_default_Centre_8">
              <font color="white"> </font>
            </para>

            <para style="terp_default_Centre_Bold_8">[[ (line2.workcenter_id and line2.workcenter_id.name) or '' ]]</para>
            <para style="terp_default_Centre_7">[[ line2.sequence ]]</para>
          </td>
          <td>
            <para style="terp_default_Centre_8">
              <font color="white"> </font>
            </para>

            <para style="terp_default_Centre_8">[[ line2.name ]]</para>
          </td>
          <td>
            <para style="P4">
              <font color="white"> </font>
            </para>
            <barCode code="Code128" barHeight="20.0" barWidth="0.8">[[ line2.opbcode or False ]]</barCode>
            <para style="P4">[[ line2.opbcode ]]</para>
          </td>
          <td>
            <para style="terp_default_Centre_8">
              <font color="white"> </font>
            </para>
            <para style="terp_default_Centre_8">[[ formatLang(line2.cycle) ]]</para>
          </td>
          <td>
            <para style="terp_default_Centre_8">
              <font color="white"> </font>
            </para>
            <para style="terp_default_Centre_8">[[ formatLang(line2.hour) ]]</para>
          </td>
        </tr>
      </blockTable>
    </section>
    <para style="P1">[[ o.routing_id.note and 'Routing Note' ]]</para>
    <para style="terp_default_Centre_8">[[ o.routing_id.note ]]</para>
    <para style="terp_default_Bold_9">
      <font color="white"> </font>
    </para>
    <para style="terp_default_Bold_9">Bill Of Material </para>
    <para style="terp_default_8">
      <font color="white"> </font>
    </para>
    <blockTable colWidths="250.0,63.0,107.0,107.0" style="Table8">
      <tr>
        <td>
          <para style="terp_tblheader_Details">Product </para>
        </td>
        <td>
          <para style="terp_tblheader_Details_Centre"></para>
        </td>
        <td>
          <para style="terp_tblheader_Details_Centre">Quantity</para>
        </td>
        <td>
          <para style="terp_tblheader_Details_Centre">Unit Quantity</para>
        </td>
      </tr>
    </blockTable>


    <section>
      <para style="terp_default_Bold_9">Scheduled Products [[ (o.product_lines == [] or o.move_lines != []) and removeParentNode('section')]]</para>
      <section>
        <para style="terp_default_8">[[ repeatIn(o.product_lines,'line') ]]</para>
        <blockTable colWidths="250.0,63.0,107.0,107.0" style="Table9">
          <tr>
            <td>
              <para style="terp_default_8">[[ (line.product_id and line.product_id.code) or '' ]] [[ (line.product_id and line.product_id.name) or '' ]]</para>
            </td>
            <td>
              <para style="terp_default_8">[[ (line.product_uom and line.product_uom.name) or '']] </para>
            </td>
            <td>
              <para style="terp_default_8_right">[[ formatLang( line.product_qty) ]]</para>
            </td>
            <td>
              <para style="terp_default_9_bold_right">[[ formatLang( line.product_qty / o.product_qty) ]]</para>
            </td>
          </tr>
        </blockTable>
      </section>
    </section>


    <section>
      <para style="terp_default_Bold_9">Products to Consume [[ o.move_lines ==[] and removeParentNode('section')]]</para>
      <section>
        <para style="terp_default_8">[[ repeatIn(o.move_lines,'line') ]]</para>
        <blockTable colWidths="250.0,65.0,108.0,104.0" style="Table9">
          <tr>
            <td>
              <para style="terp_default_8">[[ (line.product_id and line.product_id.code) or '' ]] [[ (line.product_id and line.product_id.name) or '' ]]</para>
            </td>
            <td>
              <para style="terp_default_8">[[ formatLang( line.product_qty) ]] [[ (line.product_uom and line.product_uom.name) or '']] </para>
            </td>
            <td>
              <para style="terp_default_8">[[ (line.location_id and line.location_id.name) or '' ]]</para>
            </td>
            <td>
              <para style="terp_default_8">[[ (line.location_dest_id and line.location_dest_id.name) or '' ]]</para>
            </td>
          </tr>
        </blockTable>
      </section>
    </section>

    <section>
      <para style="terp_default_Bold_9">
        <font color="white"> </font>
      </para>
      <para style="terp_default_Bold_9">Consumed Products [[ o.move_lines2 ==[] and removeParentNode('section')]]</para>
      <section>
        <para style="terp_default_8">[[ repeatIn(o.move_lines2,'line2') ]]</para>
        <blockTable colWidths="251.0,66.0,106.0,104.0" style="Table10">
          <tr>
            <td>
              <para style="terp_default_8">[[ (line2.product_id and line2.product_id.code) or '' ]] [[ (line2.product_id and line2.product_id.name) or '' ]]</para>
            </td>
            <td>
              <para style="terp_default_8">[[ formatLang( line2.product_qty) ]] [[ (line2.product_uom and line2.product_uom.name) or '']] </para>
            </td>
            <td>
              <para style="terp_default_8">[[ (line2.location_id and line2.location_id.name) or '' ]]</para>
            </td>
            <td>
              <para style="terp_default_8">[[ (line2.location_dest_id and line2.location_dest_id.name) or '' ]]</para>
            </td>
          </tr>
        </blockTable>
      </section>
      <para style="terp_default_8">
        <font color="white"> </font>
      </para>
    </section>
    <section>
      <para style="terp_header">Notes [[ o.notes == False and removeParentNode('section')]]</para>
      <section>
        <para style="terp_default_8">[[ o.notes ]]</para>
      </section>
    </section>

  </story>
</document>

