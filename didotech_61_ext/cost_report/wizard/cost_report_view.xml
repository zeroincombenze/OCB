<openerp>
    <data>
        
        <!--  Product Cost Structure Report -->
        
        <record id="view_mrp_product_detailed_price_wizard" model="ir.ui.view">
            <field name="name">Product Nested Cost Structure</field>
            <field name="model">mrp.product_price</field>
            <field name="arch" type="xml">
                <form string="Detailed Structure Cost Report">
   		            <group colspan="2" col="2">
	                    <group string="Print Detailed Cost Structure of Product." colspan="2" col="2">
	                        <field name="number"/>
	   		            	<group colspan="6" col="6">
		                        <field name="listflat"/>
		                        <field name="liststandard"/>
		                        <field name="pricedigits"/>
		                        <field name="usestandard" />
		                    </group>
	                    </group>
			            <group colspan="2" col="2">
			            	<button icon="gtk-cancel" special="cancel" string="Cancel"/>
			            	<button icon="terp-gtk-go-back-rtl" string="Print" name="print_detailed_report" type="object"/>
			            </group>
		            </group>
                </form>
            </field>
        </record>

