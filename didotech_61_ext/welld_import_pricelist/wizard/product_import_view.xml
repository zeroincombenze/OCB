<?xml version="1.0" encoding="UTF-8"?>
<!--
	ATTENZIONE:
	nella lista di file XML presente alla voce update_xml del dictionary nel file __openrp__.py
	del modulo purchase_import_pricelist IL PRESENTE FILE VA INSERITO IN LISTA PRIMA DEI FILES CHE CONTENGONO
	DEFINIZIONI CHE RIFERISCONO GLI IDs QUI DICHIARATI, quindi il file partner_properties_view.xml
-->
<openerp>
    <data>
    
        <!-- Wizard: schermata che chiede percorso del file ed encoding del testo -->
        <record id="view_product_import_form" model="ir.ui.view">
            
            <!-- Nome della vista -->
            <field name="name">pricelist.import.form</field>
            
            <!-- Modello (tabella del BD) di cui la vista visualizza i dati -->
            <field name="model">pricelist.import</field>
            
            <!-- Tipo di vista, ovvero architettura principale della vista, in questo caso è un form -->
            <field name="type">form</field>
            <field name="mode">form</field>
            
            <!-- Specifica della struttura della vista usando XML -->
            <field name="arch" type="xml">
            
            <!-- Inizio della descrizione della struttura della vista -->
                
                <form>

                    <!-- Invisible field used for hiding and showing widgets based on state value and accessing preview text -->
                    <field name="state" invisible="1"/>
                    <field name="preview_text_original" invisible="1"/>
                    
                
                    <!-- Items visibles in state "import" -->
                    <group colspan="8" col="8" states="import">
                        <!-- Percorso del file -->
                        <field name="file_name" invisible="1" />
                        <field name="pricelist_base64" filename="file_name"/>
                        <!-- Fornitore -->
                        <!-- L'attributo domain permette di restringere la scelta ai soli partners che sono anche fornitori -->
                        <!--<field name="supplier" domain="[('supplier','=','True'),]"/>-->
                    </group>
					<group colspan="8" col="8" states="import">
                        <!-- Unita di misura -->
                        <!--<field name="uom"/>-->
                        <field name="pricelist_format"/>
                    </group>
                    <!-- Items visibles in state "preview" -->
                    
                    <!-- Textbox per la preview -->
                    <group colspan="8" col="8" states="preview">
                        <!-- Box del testo decodificato -->
                        <field name="preview_text_decoded" nolabel="1"/>
                    </group>
                   
                   <!-- Items per lo stato end -->
                   <group colspan="8" col="8" states="end">
                        <label string="Importing pricelist. You will be notified with a message when the import process is finished"/>
                    </group>
                   
                   <!-- Separatore --> 
                    <group colspan="8" col="8">    
                        <separator string="" colspan="8"/>
                        <label colspan="6" width="220"/>
                    </group>
                    
                    <!-- Pulsanti per lo stato "import" -->
                    <group colspan="8" col="8" states="import">
                        <button icon="gtk-cancel" special="cancel" string="Cancel"/>
                        <button type="object" name="actionCheckEncoding" string="Start import" icon="gtk-ok"/>
                    </group>
                    
                    <!-- Pulsanti per lo stato "preview" -->
                    <group colspan="8" col="8" states="preview">
                    <!--<group colspan="8" col="8" states="import">-->
                        <separator string="" colspan="8"/>
                        <label colspan="6" width="220"/>
                        <button icon="gtk-cancel" special="cancel" string="Cancel"/>
                        <button type="object" name="actionStartImport" string="Start import" icon="gtk-ok"/>
                    </group>
                    
                    <!-- Items visibles in state "end" -->
                    <group colspan="8" col="8" states="end">
                        <button icon="gtk-ok" special="cancel" string="Close"/>
                    </group>
                    
                </form>
            <!-- Fine della descrizione della struttura della vista -->
            
            </field>
        </record>
        
        <!-- Azione per aprire il wizard, questa azione viene associata ad una voce di menu definita in purchase_import_pricelist/partner_properties_view.xml -->
        <record id="action_pricelist_import" model="ir.actions.act_window">
            <field name="name">Importa file listino in formato XLS/CSV</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">pricelist.import</field>
            <field name="view_type">form</field>
            <field name="view_mode">form</field>
            <!-- Non è necessario specificare la view_id perchè c'è una sola view per product.import -->
            <!-- <field name="view_id" ref="view_product_import_form"/> -->
            <field name="target">new</field>	<!-- This line identify this action as an action that starts a wizard -->
        </record>
        
    </data>
</openerp>