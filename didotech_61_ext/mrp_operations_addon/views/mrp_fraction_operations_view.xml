<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>

        <record model="ir.ui.view" id="mrp_fraction_operations_search">
            <field name="name">mrp.fraction.operations.search</field>
            <field name="model">mrp.fraction_operations</field>
            <field name="type">search</field>
            <field name="arch" type="xml">
                <search string="Hours on Task">
                    <group>
                        <filter name="today" icon="terp-go-today" string="Today" domain="[('date_start','&gt;=',datetime.date.today().strftime('%%Y-%%m-%%d 00:00:00')),('date_start','&lt;=',datetime.date.today().strftime('%%Y-%%m-%%d 23:59:59'))]"/>
                        <filter icon="gtk-go-forward" string="Yesterday" domain="[('date_start','&lt;',datetime.date.today().strftime('%%Y-%%m-%%d 00:00:00')),('date_start','&gt;=',(datetime.date.today() - relativedelta(days=1)).strftime('%%Y-%%m-%%d 00:00:00'))]"/>
                        <separator orientation="vertical"/>
                        <field name="date_from" filter_domain="[('date_start','&gt;=',self)]"/>
                        <field name="date_to" filter_domain="[('date_start','&lt;=',self)]"/>
                        <separator orientation="vertical"/>
                        <field name="order_id" />
                        <field name="user_id" />
                        <filter domain="[('user_id','=',uid)]" help="My Tasks" icon="terp-personal"/>
                    </group>
                    <newline/>
                    <group expand="0" string="Group By..." >
<!--                        <filter string="Date" icon="terp-go-month" domain="[]" context="{'group_by':'date_start'}"/>-->
<!--                        <separator orientation="vertical"/>-->
                        <filter string="Operation" icon="terp-folder-green" domain="[]" context="{'group_by':'order_id'}"/>
                        <separator orientation="vertical"/>
                        <filter string="Users" icon="terp-personal" domain="[]" context="{'group_by':'user_id'}"/>
                    </group>
                </search>
             </field>
        </record>


        <record model="ir.ui.view" id="mrp_fraction_operations_tree">
            <field name="name">mrp.fraction.operations.tree</field>
            <field name="model">mrp.fraction_operations</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="Hours on Task" editable="top">
                    <field name="user_id"/>
                    <field name="date" required="True"/>
                    <field name="order_id" context="{'view_full_name': True}"/>
                    <field name="working_time" widget="float_time" sum="SUM" required="True"/>
                    <field name="production_qty" />
                </tree>
             </field>
        </record>

        <record id="action_view_mrp_fraction_operations" model="ir.actions.act_window">
            <field name="name">Hours on Task</field>
            <field name="res_model">mrp.fraction_operations</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'view_full_name': True}</field>
            <field name="search_view_id" ref="mrp_fraction_operations_search"/>
        </record>

        <menuitem name="Operations"
                  id="menu_mrp_operations"
                  parent="base.menu_mrp_root"/>

        <menuitem id="menu_project_task_work_list"
                  name="Hours on Task"
                  parent="menu_mrp_operations"
                  action="action_view_mrp_fraction_operations"
        />

    </data>
</openerp>