<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>

        <record id="mrp_production_search_inherit" model="ir.ui.view">
            <field name="name">mrp.production.search.inherit</field>
            <field name="model">mrp.production</field>
            <field name="type">search</field>
            <field name="inherit_id" ref="mrp.view_mrp_production_filter" />
            <field name="arch" type="xml">
<!--                <field name="name" position="before">-->
<!--                    <field name="sale_id"/>-->
<!--                </field>-->
                <field name="product_id" position="after">
                    <field name="product_bom_ids" />
                </field>
                <field name="origin" position="after">
                    <field name="priority" />
                    <field name="user_id" />
                </field>
                <filter string="Product" position="after">
                    <filter icon="terp-personal" string="User" domain="[]" context="{'group_by':'user_id'}" />
                </filter>
            </field>
        </record>

        <record id="mrp_production_tree_inherit" model="ir.ui.view">
            <field name="name">mrp.production.tree.inherit</field>
            <field name="model">mrp.production</field>
            <field name="type">tree</field>
            <field name="inherit_id" ref="mrp.mrp_production_tree_view" />
            <field name="arch" type="xml">
                <field name="name" position="before">
                    <field name="user_id" />
                    <field name="priority"/>
                    <field name="sale_id"/>
                </field>
                <field name="state" position="after">
                    <field name="production_material_cost" sum="production_material_cost" />
                    <field name="total_delay" widget="float_time"/>
                </field>
            </field>
        </record>

        <record id="view_mrp_production_form" model="ir.ui.view">
            <field name="name">mrp.production.form</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <xpath expr="/form/notebook/page/field[@name='move_prod_id']" position="after">
                    <field name="sale_id"/>
                </xpath>
                <xpath expr="/form/notebook/page[@string='Work Orders']/field[@name='workcenter_lines']/tree/field[@name='hour']" position="replace">
                    <field name="hour" widget="float_time" sum="hours_sum"/>
                    <field name="delay" widget="float_time" sum="hours_sum" />
                    <field name="production_qty" />
                </xpath>
                <xpath expr="/form/notebook/page[@string='Work Orders']/field[@name='workcenter_lines']/form/field[@name='hour']" position="after">
                    <field name="operation_fractions_ids" nolabel="1" colspan="4">
                        <tree string="Working Time">
                            <field name="user_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="working_time" widget="float_time" sum="SUM"/>
                            <field name="production_qty" />
                        </tree>
                    </field>
                </xpath>
                <notebook position="inside">
                    <page string="Note">
                        <field name="notes" nolabel="1" />
                    </page>
                </notebook>
            </field>
        </record>

    </data>
</openerp>
