        </record>

        <record model="ir.actions.act_window" id="mrp_production_wc_action_kanban">
            <field name="name">Work Orders for Work Center</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">mrp.production.workcenter.line</field>
            <field name="view_type">form</field>
            <field name="view_mode">kanban</field>
            <field name="domain">[('state', '!=', 'done')]</field>
            <field name="context">{'block_change': True}</field>
            <field name="search_view_id" ref="mrp_operations.view_mrp_production_workcenter_form_view_filter"/>
        </record>

        <menuitem name="Work Orders for Work Center" parent="mrp.menu_mrp_manufacturing"
                  id="menu_mrp_production_wc_order_kanban_workcenter"
                  action="mrp_production_wc_action_kanban" sequence="3"/>

        <record model="ir.actions.act_window.view" id="mrp_production_wc_view_kanban_workcenter">
            <field name="sequence" eval="2"/>
            <field name="view_mode">kanban</field>
            <field name="view_id" ref="view_mrp_production_workcenter_line_kanban_workcenter"/>
            <field name="act_window_id" ref="mrp_production_wc_action_kanban"/>
        </record>

        <record model="ir.actions.act_window.view" id="mrp_production_wc_action_kanban_user_user_id">
            <field name="sequence" eval="20"/>
            <field name="view_mode">kanban</field>
            <field name="view_id" ref="view_mrp_production_workcenter_line_kanban"/>
            <field name="act_window_id" ref="mrp_operations.mrp_production_wc_action_form"/>
        </record>

        <record model="ir.actions.act_window.view" id="mrp_production_wc_action_tree_user_user_id">
            <field name="sequence" eval="1"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="mrp_operations.mrp_production_workcenter_tree_view_inherit"/>
            <field name="act_window_id" ref="mrp_operations.mrp_production_wc_action_form"/>
        </record>

    </data>
</openerp>
