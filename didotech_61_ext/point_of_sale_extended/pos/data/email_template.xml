<openerp>
    <data>

        <record id="send_picking_out" model="email.template">
            <field name="name">Send Picking List</field>
            <field name="email_from">${object.user_id.user_email or object.company_id.email or 'noreply@localhost'}</field>
            <field name="subject">Internal Transfert</field>
            <field name="email_to">${object.user_id and object.user_id.user_email or object.project_id and object.project_id.user_id and object.project_id.user_id.user_email or ''}</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="auto_delete" eval="False"/>
            <field name="report_template" eval="stock.report_picking_list" />
            <field name="lang">${object.partner_id.lang}</field>
            <field name="body_html"><![CDATA[

            ]]></field>
            <field name="body_text"><![CDATA[**MOVIMENTO INTERNO**
            Ciao ${object.user_id and object.user_id.name or 'TASK NON ASSEGNATA'}
In allegato il DDT del trasferimento
            ]]></field>
        </record>

    </data>
</openerp>
