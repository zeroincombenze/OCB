<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>

        <record id="account_comp_rule_all_invoice" model="ir.rule">
            <field name="name">All invoice</field>
            <field model="ir.model" name="model_id" ref="account.model_account_invoice"/>
            <field name="groups" eval="[(4, ref('point_of_sale.group_pos_manager_extended')), (4, ref('account.group_account_invoice'))]"/>
            <field name="domain_force">[(1,'=', 1)]</field>
        </record>

        <record id="account_comp_rule_own_invoice" model="ir.rule">
            <field name="name">Only own invoice</field>
            <field model="ir.model" name="model_id" ref="account.model_account_invoice"/>
            <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
            <field name="domain_force">['|', ('journal_id.user_id','=',user.id), ('journal_id.user_id','=',False)]</field>
        </record>

        <record id="account_comp_rule_all_journal" model="ir.rule">
            <field name="name">All Journal</field>
            <field model="ir.model" name="model_id" ref="account.model_account_journal"/>
            <field name="groups" eval="[(4, ref('point_of_sale.group_pos_manager_extended'))]"/>
            <field name="domain_force">[(1,'=', 1)]</field>
        </record>

        <record id="account_comp_rule_own_journal" model="ir.rule">
            <field name="name">Only own invoice</field>
            <field model="ir.model" name="model_id" ref="account.model_account_journal"/>
            <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user')), (4, ref('account.group_account_invoice'))]"/>
            <field name="domain_force">['|', ('user_id','=',user.id), ('user_id','=',False)]</field>
        </record>

    </data>
</openerp>
