<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>

        <record id="group_pos_order_cancel" model="res.groups">
            <field name="name">Can Cancel Pos Order</field>
            <field name="category_id" ref="base.module_category_point_of_sale"/>
            <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
        </record>

        <record id="account_comp_rule_all_history" model="ir.rule">
            <field name="name">All history</field>
            <field model="ir.model" name="model_id" ref="point_of_sale_extended.model_pos_history"/>
            <field name="groups" eval="[(4, ref('point_of_sale.group_pos_manager'))]"/>
            <field name="domain_force">[(('shop_id.member_ids', 'in', user.id))]</field>
        </record>

        <record id="account_comp_rule_own_history" model="ir.rule">
            <field name="name">Only my history</field>
            <field model="ir.model" name="model_id" ref="point_of_sale_extended.model_pos_history"/>
            <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
            <field name="domain_force">[('shop_id.pos_user_id', '=', user.id)]</field>
        </record>

    </data>
</openerp>
