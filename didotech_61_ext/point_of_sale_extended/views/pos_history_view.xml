        <record model="ir.ui.view" id="view_pos_history_tree">
            <field name="name">Sales</field>
            <field name="model">pos.history</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="POS History"
                      colors="aqua:row_color=='aqua';black:row_color=='black';blue:row_color=='blue';brown:row_color=='brown';cadetblue:row_color=='cadetblue';darkblue:row_color=='darkblue';fuchsia:row_color=='fuchsia';forestgreen:row_color=='forestgreen';orange:row_color=='orange';green:row_color=='green';grey:row_color=='grey';red:row_color=='red';">
                    <field name="shop_id" invisible="context.get('group_by', False) in ['shop_id']"/>
                    <field name="date"/>
                    <field name="day_of_week" invisible="context.get('group_by', False) in ['day_of_week']"/>
                    <field name="week_nbr" invisible="context.get('group_by', False) in ['day_of_week']"/>
                    <field name="amount_untax" sum="Total Untax"/>
                    <field name="amount_tax" sum="Total Tax"/>
                    <field name="amount_total" sum="Total Amount"/>
                    <field name="cash_register_amount" sum="Total Register Amount"/>
                    <field name="amount_difference"/>
                    <field name="number_sale" invisible="context.get('group_by', False) in ['day_of_week']"/>
                    <field name="pce_sell" avg="Average" invisible="context.get('group_by', False) in ['day_of_week']"/>
                    <field name="avarage_sale" avg="Average sale" invisible="context.get('group_by', False) in ['day_of_week']"/>
                    <field name="avarage_line" avg="Average line" invisible="context.get('group_by', False) in ['day_of_week']"/>
                    <field name="pos_discount" invisible="context.get('group_by', False) in ['day_of_week']"/>
                    <field name="state" />
                    <!--<field name="last_week_difference" />-->
                    <field name="row_color" invisible="1"/>
                </tree>
            </field>
        </record>

        <record id="view_pos_history_filter" model="ir.ui.view">
            <field name="name">pos.history.list.select</field>
            <field name="model">pos.history</field>
            <field name="type">search</field>
            <field name="arch" type="xml">
                <search string="Search Sales Order">

                    <filter icon="terp-go-month"
                            string="Last Month"
                            name="last_month"
                            help="History of the last month"
                            domain="[('date', '&lt;', datetime.date.today().strftime('%%Y-%%m-01 00:00:00')), ('date', '&gt;=', (datetime.date.today() - relativedelta(months=1)).strftime('%%Y-%%m-01 00:00:00'))]"
                    />
                    <filter icon="terp-go-month"
                            string="Current Month"
                            name="current_month"
                            help="History of the current month"
                            domain="[('date', '&lt;', (datetime.date.today() + relativedelta(months=1)).strftime('%%Y-%%m-01 00:00:00')), ('date', '&gt;=', (datetime.date.today()).strftime('%%Y-%%m-01 00:00:00'))]"
                    />
                    <separator orientation="vertical"/>
                    <filter icon="terp-go-week"
                            string="Last Week"
                            name="last_week"
                            help="History for last week"
                            domain="[('date','&lt;=',(datetime.date.today()-relativedelta(weeks=1,weekday=6)).strftime('%%Y-%%m-%%d 23:59:59')),('date','&gt;=',(datetime.date.today()-relativedelta(weeks=2,weekday=0)).strftime('%%Y-%%m-%%d 00:00:00'))]"
                    />
                    <filter icon="terp-go-week"
                            string="This Week"
                            name="this_week"
                            help="History of this week"
                            domain="[('date','&lt;=',(datetime.date.today()-relativedelta(weekday=6)).strftime('%%Y-%%m-%%d 23:59:59')),('date','&gt;=',(datetime.date.today()-relativedelta(weeks=1,weekday=0)).strftime('%%Y-%%m-%%d 00:00:00'))]"
                    />
                    <separator orientation="vertical"/>
                    <filter icon="STOCK_INDEX"
                            string="To validate"
                            domain="[('state','=','draft')]"
                            name="pos history"
                            help="Pos History still in draft state"
                    />


                    <separator orientation="vertical"/>
                    <field name="date_from" filter_domain="[('date','&gt;=',self)]"/>
                    <field name="date_to" filter_domain="[('date','&lt;=',self)]"/>
                    <field name="day_of_week"/>
                    <separator orientation="vertical"/>
                    <field name="shop_id" widget="selection"/>
                    <newline/>
                    <group expand="0" string="Group By..." colspan="4" col="20" groups="base.group_extended">
                        <filter string="Shop" name="shop" icon="gtk-network" domain="[]"
                                context="{'group_by': 'shop_id'}"/>
                        <filter string="Day of week" name="day" icon="terp-go-today" domain="[]"
                                context="{'group_by': 'day_of_week'}"/>
                        <filter string="Week Number" name="day" icon="terp-go-today" domain="[]"
                                context="{'group_by': 'week_nbr'}"/>
                    </group>
                </search>
            </field>
        </record>

        <menuitem parent="point_of_sale.menu_point_of_sale" id="menu_point_ofsale_history"
                  action="action_pos_history_form" sequence="100"
                  groups="point_of_sale.group_pos_user,point_of_sale.group_pos_manager"/>

        <!--<menuitem parent="point_of_sale.menu_point_of_sale" id="menu_point_ofsale_history_shop"-->
