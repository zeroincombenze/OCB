<?xml version="1.0"?>
<openerp>
    <data>

        <!--point_of_sale.action_pos_order_line-->

        <record model="ir.ui.view" id="view_pos_order_line_graph">
            <field name="name">Pos History</field>
            <field name="model">pos.order.line</field>
            <field name="type">graph</field>
            <field name="arch" type="xml">
                <graph string="Vendite" type="bar">
                    <field name="categ_id"/>
                    <field name="price_subtotal" operator="+"/>
                    <field name="shop_id" group="True"/>
                </graph>

            </field>
        </record>

        <!--<graph string="a" type="gauge">-->
                    <!--<field name="shop_id"/>-->
                    <!--<field name="amount_total" operator="+"/>-->
                <!--</graph>-->



        <record model="ir.ui.view" id="view_pos_history_graph">
            <field name="name">Pos History</field>
            <field name="model">pos.history</field>
            <field name="type">graph</field>
            <field name="arch" type="xml">
                <graph string="Vendite" type="bar">
                    <field name="date"/>
                    <field name="amount_total" operator="+"/>
                    <field name="shop_id" group="True"/>
                </graph>
                <graph string="Negozi" type="gauge">
                    <field name="shop_id"/>
                    <field name="amount_total" operator="+"/>
                    <html>
                        <graph-options>
                            {

                            max:30000,
                            redFrom: 90, redTo: 100,
                            yellowFrom:75, yellowTo: 90,
                            minorTicks: 5
                            }
                        </graph-options>
                    </html>
                </graph>
            </field>
        </record>

        <record model="ir.ui.view" id="view_pos_history_graph_shop">
            <field name="name">Pos History</field>
            <field name="model">pos.history</field>
            <field name="type">graph</field>
            <field name="arch" type="xml">
                <graph string="Negozi" type="gauge">
                    <field name="shop_id"/>
                    <field name="amount_total" operator="+"/>
                    <html>
                        <graph-options>
                            {

                            max:30000,
                            redFrom: 90, redTo: 100,
                            yellowFrom:75, yellowTo: 90,
                            minorTicks: 5
                            }
                        </graph-options>
                    </html>
                </graph>
            </field>
        </record>

        <record model="ir.ui.view" id="view_pos_history_form">
            <field name="name">pos.history</field>
            <field name="model">pos.history</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="PoS History">
                    <group col="7" colspan="4">
                        <group col="2" colspan="2" >
                            <field name="date"/>
                        </group>
                        <group col="2" colspan="2" string="Incasso Registratore di Cassa">
                            <field name="amount_total"/>
                            <field name="cash_register_amount"/>
                            <field name="note"/>
                        </group>
                    </group>
                    <notebook colspan="4">
                        <page string="Sale Order">
                            <field name="pos_order_ids" colspan="4" nolabel="1"/>
                        </page>
                        <page string="Payment">
                            <field name="statement_ids" colspan="4" nolabel="1">
                                <tree string="Statement">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="journal_id"/>
                                    <field name="total_entry_encoding" sum="Sum Balance"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <field name="state" widget="statusbar" statusbar_visible="draft,valid"
                           statusbar_colors="{&quot;cancel&quot;:&quot;red&quot;}"/>
                    <button name="action_confirm" states="draft" string="Generate Entries" colspan="1" type="object"
                            icon="gtk-ok"/>
                </form>
            </field>
        </record>


        <record model="ir.actions.act_window" id="action_pos_history_form">
            <field name="name">PoS History</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">pos.history</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form,graph</field>
            <field name="context">{'nodelete': '1', 'nocreate': '1', 'noduplicate': '1'}</field>
            <field name="limit">200</field>
            <field name="view_id" eval="False"/>
            <field name="domain">[]</field>
        </record>

