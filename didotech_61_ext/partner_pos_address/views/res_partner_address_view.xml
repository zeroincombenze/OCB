<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <record id="view_partner_pos_address_filter" model="ir.ui.view">
            <field name="name">res.partner.address.select</field>
            <field name="model">res.partner.address</field>
            <field name="type">search</field>
            <field name="arch" type="xml">
                <search string="Search Contact">
                    <group>
						<filter domain="[('close', '=',True)]" help="Protocolli Aperti " icon="terp-gtk-stop" name="Chiusi" string="Chiusi" />
                        <separator orientation="vertical"/>
                        <field name="partner_id" string="Group"/>
                        <field name="banner_id" widget="selection" />
						<field name="province" widget="selection" />
						<field name="city"/>
                        <field name="tag"/>
                        <field name="region" widget="selection" />
                    </group>
                     <newline/>
                    <group expand="0" string="Group By...">
                       <filter string="Group" icon="terp-personal" domain="[]" context="{'group_by' : 'partner_id'}" />
                       <filter string="Banner" icon="terp-go-home" domain="[]" context="{'group_by' : 'banner_id'}" />
                       <separator orientation="vertical"/>
                       <filter string="Province" icon="terp-go-home" domain="[]" context="{'group_by' : 'province'}" />
                   </group>
                </search>
            </field>
        </record>


        <record id="view_partner_pos_address_form" model="ir.ui.view">
            <field name="name">res.partner.address.partner.pos.address.inherit</field>
            <field name="model">res.partner.address</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Address">
                    <group colspan="4" col="6">
                        <field name="partner_id" colspan="2" required="1" string="Group"  domain="[('customer','=', False)]" on_change="onchange_partner_id(partner_id)"/>
                        <field name="banner_id" required="1" domain="[('group_ids','=',partner_id)]" attrs="{'invisible':[('partner_id','=',False)]}" context="{'partner_id': partner_id}"/>
                        <field name="tag" />
                        <newline/>
                        <field name="name"/>
                        <field name="is_pos" invisible="1"/>
						<field name="close"/>
                        <field domain="[('domain', '=', 'contact')]" name="title" widget="selection"/>
                        <field name="function"/>
                    </group>
                    <notebook colspan="4">
                        <page string="General">
                            <group colspan="2" col="4">
                                <separator string="Postal Address" colspan="4" col="4"/>
                                <field name="type" invisible="1" /><newline/>
                                <field name="street"/><newline/>
                                <label string="Street2 : " align="1.0"/>
                                <group colspan="1" col="2">
                                    <field name="street2" nolabel="1"/>
                                </group>
                                <newline/>
                                <field name="city" on_change="on_change_city(city)"/>
                                <field name="zip"/>
                                <field name="province" />
                                <field name="region" />
                                <field name="country_id" completion="1"/>
                                <field name="state_id"/>
                            </group>
							<group colspan="2" col="2">
								<group colspan="2" col="2">
									<separator string="Communication" colspan="4" col="4"/>
									<field name="phone"/>
									<field name="fax"/>
									<field name="mobile"/>
									<field name="email" widget="email"/>
								</group>
<!--
							<group colspan="2" col="2">
                                <separator string="Availability" colspan="4" col="4"/>
                                <field name="hour_from" widget="float_time"/>
                                <field name="hour_to" widget="float_time"/>
                            </group>
-->							</group>
                            <group colspan="4" col="4">
                                <group colspan="2" col="2">
                                    <separator string="Director" colspan="2" col="2"/>
                                    <field name="director_ids" nolabel="1" colspan="2"  >
                                        <!--<form string="Director" > 
                                            <field name="name" />
                                            <field name="department_id" widget="selection"/>
                                            <field name="phone" />
                                            <field name="email" widget="email"/>    
                                        </form>-->
                                        <tree editable="top">
                                            <field name="name" />
                                            <field name="department_id" widget="selection"/>
                                            <field name="phone" />
                                            <field name="email"/>
                                        </tree>
                                    </field>
                                </group>
                                <group colspan="2" col="2">
                                    <separator string="Working Day" colspan="4" col="4"/>
                                    <field name="working_day_ids" nolabel="1" colspan="2" >
                                        <!--<form string="Working Day">
                                            <field name="dayofweek"/> 
                                            <field name="hour_from" widget="float_time"/>
                                            <field name="hour_to" widget="float_time"/>
                                        </form>-->
                                        <tree string="Working Day" editable="top">
                                            <field name="dayofweek"/>
                                            <field name="hour_from" widget="float_time"/>
                                            <field name="hour_to" widget="float_time"/>
                                        </tree>
                                  </field>
                                </group>
                            </group>
                        </page>
                        <page string="Customer Codes" >
                            <group colspan="4" col="4">
                                <separator string="Customer Codes" colspan="4" col="4"/>
                                <field name="partner_codes" nolabel="1" colspan="4" >
                                    <!--<form string="Customer Codes">
                                        <field name="partner_id" />
                                        <field name="code" />
                                    </form>-->
                                    <tree string="Customer Codes" editable="top">
                                        <field name="partner_id" />
                                        <field name="code" />
                                    </tree>
                                </field>
                            </group>
                        </page>

						<page string="Customer Agent" >
                            <group colspan="4" col="4">
                                <separator string="Customer Agent" colspan="4" col="4" />
                                <field name="partner_agent" nolabel="1" colspan="4"  >
                                    <!--<form string="Customer Codes">
                                        <field name="partner_id" />
                                        <field name="partner_agent_id" string="Agente" />
                                    </form>-->
                                    <tree string="Customer Codes" editable="top">
                                        <field name="partner_id" />
										<field name="brand_id" />
                                        <field name="partner_agent_id" string="Agente" />
                                    </tree>
                                </field>
                            </group>
                        </page>
						<page string="Portale" >
							<group colspan="4" col="4">
                                <separator string="Credenziali Accesso" colspan="4" col="4" />
								<field name="user_django" colspan="4"  />
                                <field name="password_django" colspan="4"  />

                            </group>
						</page>

                    </notebook>
                </form>
            </field>
        </record>
        <record id="view_partner_pos_address_tree" model="ir.ui.view">
            <field name="name">res.partner.address.partner.pos.address.inherit.tree</field>
            <field name="model">res.partner.address</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="POS Store Addresses">
                    <field name="partner_id" string="Group"/>
                    <field name="banner_id"/>
					<field name="province"/>
					<field name="city"/>
                    <field name="tag"/>
                    <field name="name"/>
                    <field name="phone"/>
                    <field name="email"/>
                    <field name="zip"/>
                    <field name="region"/>
					<field name="close" />
                </tree>
            </field>
        </record>
        <record id="action_partner_address_form" model="ir.actions.act_window">
            <field name="name">POS Address</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.partner.address</field>
            <field name="domain">[('type','=','pos')]</field>
            <field name="context">{'default_type': 'pos'}</field>
            <field name="search_view_id" ref="view_partner_pos_address_filter"/>
            <field name="view_type">form</field>
        </record>
        <record id="action_partner_address_form_view1" model="ir.actions.act_window.view">
            <field eval="10" name="sequence"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="view_partner_pos_address_tree"/>
            <field name="act_window_id" ref="action_partner_address_form"/>
        </record>
        <record id="action_partner_form_view2" model="ir.actions.act_window.view">
            <field eval="20" name="sequence"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_partner_pos_address_form"/>
            <field name="act_window_id" ref="action_partner_address_form"/>
        </record>

        <!--<record id="action_view_partner_pos_address_form" model="ir.actions.act_window">
            <field name="name">POS Address</field>
            <field name="res_model">res.partner.address</field>
           
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
        </record>-->
        <menuitem id="menu_partner_pos_address_view" name="POS Address" parent="base.menu_address_book" action="action_partner_address_form" />


        <record id="base.action_partner_address_form" model="ir.actions.act_window">
            <field name="domain">[('type','!=','pos')]</field>
        </record>
    </data>
</openerp>
