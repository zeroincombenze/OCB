<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
       <!--
        ==========
         res_partner_banner
        ==========
        -->
        <record id="view_res_partner_banner_filter" model="ir.ui.view">
            <field name="name">res.partner.banner.select</field>
            <field name="model">res.partner.banner</field>
            <field name="type">search</field>
            <field name="arch" type="xml">
                <search string="Search Banner">
                    <group>
                       <separator orientation="vertical"/>
                        <field name="name" />
					</group>
				</search>
			</field>
		</record>
        <record id="view_res_partner_banner_form" model="ir.ui.view">
            <field name="name">res.partner.banner.form</field>
            <field name="model">res.partner.banner</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Banner">
					<field name="name" colspan="2"/><newline/>
					<separator string="Groups" colspan="4"/>
					<field name="group_ids" colspan="4" nolabel="1"/>
                </form>
            </field>
        </record>

        <record id="view_res_partner_banner_tree" model="ir.ui.view">
            <field name="name">res.partner.banner.tree</field>
            <field name="model">res.partner.banner</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="Banner">
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <record id="action_view_res_partner_banner_form" model="ir.actions.act_window">
            <field name="name">Banner</field>
            <field name="res_model">res.partner.banner</field>
            <field name="view_type">form</field>
			<field name="search_view_id" ref="view_res_partner_banner_filter"/>
            <field name="view_mode">tree,form</field>
        </record>
        <menuitem id="menu_res_partner_banner_view" name="Partner Banner" parent="base.menu_config_address_book" action="action_view_res_partner_banner_form" />
    </data>
</openerp>
