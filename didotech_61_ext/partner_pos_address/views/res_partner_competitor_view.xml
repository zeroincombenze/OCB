<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
		<record id="view_res_partner_competitor_form" model="ir.ui.view">
            <field name="name">res.partner.competitor.form</field>
            <field name="model">res.partner.competitor</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Competitor">
                    <field name="partner_id" />
					<field name="brand_id" />
					<separator string="Product Categories" colspan="4" />
                    <field name="product_category_ids" nolabel="1" colspan="4" />
                </form>
            </field>
        </record>
		<record id="view_res_partner_competitor_tree" model="ir.ui.view">
            <field name="name">res.partner.competitor.tree</field>
            <field name="model">res.partner.competitor</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="Competitor">
                    <field name="partner_id" />
					<field name="brand_id" />
                </tree>
            </field>
        </record>
        <record id="view_res_partner_competitor_search" model="ir.ui.view">
            <field name="name">res.partner.competitor.search</field>
            <field name="model">res.partner.competitor</field>
            <field name="type">search</field>
            <field name="arch" type="xml">
                <search string="Competitor">
                    <field name="partner_id" />
					<field name="brand_id" />
                </search>
            </field>
        </record>
    </data>
</openerp>
