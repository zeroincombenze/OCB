<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
		<!--INHERIT DI BASE_CONTACT-->
		<record id="view_partner_job_form" model="ir.ui.view">
			<field name="name">res.partner.job.form.inherit</field>
			<field name="model">res.partner.job</field>
			<field name="type">form</field>
            <field name="inherit_id" ref="base_contact.view_partner_job_form"/>
            <field name="arch" type="xml">
                <field name="function" position="replace">
                    <field name="brand_id" colspan="4" />
                </field>
            </field>
        </record>

        <record model="ir.ui.view" id="view_partner_job_tree">
            <field name="name">res.partner.job.tree.inherit</field>
            <field name="model">res.partner.job</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
            <field name="inherit_id" ref="base_contact.view_partner_job_tree"/>
                <tree string="Contact Functions">
                    <field name="function" position="replace">
                        <field name="brand_id" colspan="4"/>
                    </field>
                </tree>
            </field>
        </record>
    </data>
</openerp>
