        ==========
         res_partner_brand
        ==========
        -->
        
        <record id="view_res_partner_brand_form" model="ir.ui.view">
            <field name="name">res.partner.brand.form</field>
            <field name="model">res.partner.brand</field>
            <field name="type">form</field>        
            <field name="arch" type="xml">
                <form string="Brand">
                    <field name="name"/>
                    <field name="owner_id" />
                </form>
            </field>
        </record>
        <record id="view_res_partner_brand_tree" model="ir.ui.view">
            <field name="name">res.partner.brand.tree</field>
            <field name="model">res.partner.brand</field>
            <field name="type">tree</field>        
            <field name="arch" type="xml">
                <tree string="Brand" editable="top">
                    <field name="name"/>
                    <field name="owner_id" />
                </tree>
            </field>
        </record>
        
        <record id="view_res_partner_brand_select" model="ir.ui.view">
            <field name="name">res.partner.brand.select</field>
            <field name="model">res.partner.brand</field>
            <field name="type">search</field>        
            <field name="arch" type="xml">
                <search string="Brand">
                    <field name="name"/>
                    <field name="owner_id" />
                </search>
            </field>
        </record>
        
        <record id="action_view_res_partner_brand_form" model="ir.actions.act_window">
            <field name="name">Brand</field>
            <field name="res_model">res.partner.brand</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
        </record>
        <menuitem id="menu_view_res_partner_brand_form" name="Partner Brand" parent="base.menu_config_address_book" action="action_view_res_partner_brand_form" />

