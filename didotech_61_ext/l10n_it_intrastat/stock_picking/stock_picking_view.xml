<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <record id="view_stock_picking_in_form_intrastat_inherit" model="ir.ui.view">
            <field name="name">stock.picking.in.form.intrastat.inherit</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_in_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form/notebook/page[@string='Notes']" position="after" >
                    <page string="Intrastat" groups="l10n_it_intrastat.account_invoice_intrastat_group">
                        <field name="country_provenance" colspan="4"/>
                        <field name="province_destination" colspan="4"/>
                        <field name="way_of_freight" colspan="4"/>
                    </page>
                </xpath>
            </field>
        </record>
        
        <record id="view_stock_picking_out_form_intrastat_inherit" model="ir.ui.view">
            <field name="name">stock.picking.out.form.intrastat.inherit</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_out_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form/notebook/page[@string='Notes']" position="after" >
                    <page string="Intrastat" groups="l10n_it_intrastat.account_invoice_intrastat_group">
                        <field name="country_provenance" colspan="4"/>
                        <field name="province_destination" colspan="4"/>
                        <field name="way_of_freight" colspan="4"/>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</openerp>
