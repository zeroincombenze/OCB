<?xml version="1.0"?>
<openerp>
    <data>
    
        <record id="view_order_form_inherit" model="ir.ui.view">
            <field name="name">sale.order.rent.form</field>
            <field name="model">sale.order</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">
                <field name="date_confirm" position="after">
                    <field name="pick_up_date"/>
                </field>
                <xpath expr="//form[@string='Sales Order Lines']/notebook" position="inside">
                    <page string="Rental Info" attrs="{'invisible': [('product_type', 'not in', ('service',))]}">
                        <group>
                            <field name="date_start_rent" on_change="onchange_date(date_start_rent, date_end_rent, product_id, parent.partner_shipping_id)"  string="Rent from to"/>
                            <field name="date_end_rent" on_change="onchange_date(date_start_rent, date_end_rent, product_id, parent.partner_shipping_id)" nolabel="1"/>
                            <newline/>
                            <field name="duration" on_change="onchange_date(date_start_rent, date_end_rent, product_id, parent.partner_shipping_id)" />
                            <newline/>
                            <field name="rentable_free" />
                            <newline/>
                            <field name="rentable_reserved" />
                            <newline/>
                            <field name="rentable_booked" />
                        </group>
                    </page>

                </xpath>
                <xpath expr="//field[@name='order_line' or @name='abstract_line_ids']/tree/field[@name='product_uom']" position="after">
                    <field name="duration" />
                </xpath>
                <field name="order_line" position="attributes">
                    <attribute name="on_change">onchange_order_line(order_line, partner_shipping_id)</attribute>
                </field>
                <button name="cancel" position="after">
                    <button name="action_rent_select" states="rent_selection" string="Select Rentable Products" type="object" icon="terp-camera_test"/>
                </button>
            </field>
        </record>
        
        <record id="view_sales_order_rent_line_filter" model="ir.ui.view">
            <field name="name">sale.order.rent.line</field>
            <field name="model">sale.order.line</field>
            <field name="type">search</field>
            <field name="arch" type="xml">
                <search string="Search rent Lines">
                    <field name="order_id"/>
                    <field name="order_partner_id"/>
                    <field name="product_id" domain="[('type', '=', 'service')]"/>
                    <field name="date_start_rent"/>
                    <field name="date_end_rent"/>
                    <field name="salesman_id">
                        <filter icon="terp-personal" domain="[('salesman_id', '=', uid)]" help="My Sales Order Lines"/>
                    </field>
                    <newline/>
                    <group expand="0" string="Group By...">
                        <filter string="Order" icon="terp-gtk-jump-to-rtl" domain="[]" context="{'group_by': 'order_id'}" help="Order reference"/>
                        <filter string="Partner Order" icon="terp-gtk-jump-to-rtl" domain="[]" context="{'group_by': 'order_partner_id'}" />
                        
                        <filter string="Product" icon="terp-accessories-archiver" domain="[]" context="{'group_by': 'product_id'}"/>
                        <filter string="Date Start" icon="rerp-stock_calendar" domain="[]" context="{'group_by': 'date_start_rent'}" />
                        <separator orientation="vertical"/>
                        <filter string="State" icon="terp-stock_effects-object-colorize" domain="[]" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_sales_order_rent_line_tree" model="ir.ui.view">
            <field name="name">sale.order.rent.line</field>
            <field name="model">sale.order.line</field>
            <field name="type">tree</field>
            <field name="priority" eval="100"/>
            <field name="arch" type="xml">
                <tree string="Rent Lines">
                    <field name="order_id"/>
                    <field name="order_partner_id"/>
                    <field name="product_id"/>
                    <field name="product_uom_qty" string="Qty"/>
                    <field name="date_start_rent" />
                    <field name="date_end_rent" />
                    <field name="product_uom" string="UoM"/>
                    <field name="salesman_id"/>
                    <field name="price_subtotal" sum="Total"/>
                    <field name="state"/>   
                </tree>
            </field>
        </record>
        
        <record id="view_sales_order_rent_line_form" model="ir.ui.view">
            <field name="name">sale.order.rent.line</field>
            <field name="model">sale.order.line</field>
            <field name="type">form</field>
            <field name="priority" eval="100"/>
            <field name="arch" type="xml">
                <form string="Rent Lines">
                    <field name="order_id"/>
                    <field name="order_partner_id"/>
                    <field name="product_id"/>
                    <field name="product_uom_qty" string="Qty"/>
                    <field name="date_start_rent" />
                    <field name="date_end_rent" />
                    <field name="product_uom" string="UoM"/>
                    <field name="salesman_id"/>
                    <field name="price_subtotal" sum="Total"/>
                </form>
            </field>
        </record>
        
        <record model="ir.ui.view" id="rent_order_calendar_view">
            <field name="name">rent.sale.order.line.calendar</field>
            <field name="model">sale.order.line</field>
            <field name="type">calendar</field>
            <field name="arch" type="xml">
                <calendar string="Rent Orders" color="product_id" date_start="date_start_rent" date_stop="date_end_rent">
                    <field name="order_partner_id"/>
                    <field name="order_id" />
                    <field name="state" />
                    <field name="product_uom_qty"/>
                </calendar>
            </field>
        </record>

        <record id="action_order_line_tree2" model="ir.actions.act_window">
            <field name="name">Rent Line</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">sale.order.line</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form,calendar</field>
            <field name="search_view_id" ref="view_sales_order_rent_line_filter"/>
            <field name="context">{'nodelete': '1', 'nocreate': '1'}</field>
            <field name="domain">[('date_start_rent', '!=', False)]</field>
            <field name="filter" eval="True"/>
        </record>
        
        <record id="action_order_rent_line_tree" model="ir.actions.act_window.view">
            <field eval="5" name="sequence"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="view_sales_order_rent_line_tree"/>
            <field name="act_window_id" ref="action_order_line_tree2"/>
        </record>
        
        <record id="action_order_rent_line_form" model="ir.actions.act_window.view">
            <field eval="5" name="sequence"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_sales_order_rent_line_form"/>
            <field name="act_window_id" ref="action_order_line_tree2"/>
        </record>
        
        <menuitem name="Rent Line" id="menu_invoicing_sales_rent_lines" parent="base.menu_invoiced" action="action_order_line_tree2" sequence="3" />

        <record id="open_view_tree_rent" model="ir.actions.act_window.view">
            <field name="sequence" eval="10"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="view_sales_order_rent_line_tree" />
            <field name="act_window_id" ref="menu_invoicing_sales_rent_lines"/>
        </record>
        
        <record id="open_view_form_rent" model="ir.actions.act_window.view">
            <field name="sequence" eval="11"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_sales_order_rent_line_form" />
            <field name="act_window_id" ref="menu_invoicing_sales_rent_lines"/>
        </record>
        
        
    
