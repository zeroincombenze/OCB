<?xml version="1.0"?>
<openerp>
    <data>
    
        <record id="sale_order_rent_confirmation_form" model="ir.ui.view">
            <field name="name">sale.order.rent.confirm.form</field>
            <field name="model">sale.order.confirm</field>
            <field name="inherit_id" ref="sale_order_confirm.sale_order_confirmation_form"/>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <field name="price_subtotal" position="after">
                    <field name="sale_line_id" />
                    <field name="date_start_rent" on_change="onchange_date(sale_line_id, date_start_rent, date_end_rent)" />
                    <field name="date_end_rent" on_change="onchange_date(sale_line_id, date_start_rent, date_end_rent)" />
                </field>
            </field>
        </record>
    
    </data>
</openerp>
