<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data noupdate="1">
        <record id="document_2c_fatturapa" forcecreate="True" model="ir.cron">
            <field name="name">Update FatturaPA State</field>
            <field name="active" eval="True" />
            <field name="user_id" ref="base.user_root" />
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False" />
            <field name="model" eval="'fatturapa.attachment.out'" />
            <field name="function" eval="'update_status'" />
            <field name="args" eval="(None,)" />
        </record>

        <record id="document_2c_fatturapa_send" forcecreate="True" model="ir.cron">
            <field name="name">Send FatturaPA</field>
            <field name="active" eval="True" />
            <field name="user_id" ref="base.user_root" />
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <!-- UTC time: 21:00 -> 23:00 -->
            <field name="nextcall" eval="'{today} 21:00:00'.format(today=DateTime.now().strftime('%Y-%m-%d'))" />
            <field name="numbercall">-1</field>
            <field name="doall" eval="False" />
            <field name="model" eval="'fatturapa.attachment.out'" />
            <field name="function" eval="'send_cron_invoice_sdi'" />
            <field name="args" eval="(None,)" />
        </record>
    </data>
</openerp>