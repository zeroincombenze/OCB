<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>

        <delete id="product_no_tax.view_account_account_form_tax_hide" model="ir.ui.view"/>

        <record id="view_fatturapa_in_attachment_form" model="ir.ui.view">
            <field name="name">fatturapa.attachment.in.form</field>
            <field name="model">fatturapa.attachment.in</field>
            <field name="arch" type="xml">
                <form string="Import FatturaPA">
                    <group col="4" colspan="4">
                        <group>
                            <field name="datas" filename="datas_fname"
                                   attrs="{'readonly': [('xml_supplier_id', '!=', False)]}" nolabel="1"/>
                            <field name="datas_fname" on_change="set_name(datas_fname)" invisible="1"/>
                            <field name="name" invisible="1"/>
                            <newline/>
                            <group col="2" colspan="2">
                                <field name="sdi_id"/>
                                <field name="sdi_date"/>
                            </group>
                        </group>

                        <group>
                            <field name="xml_supplier_id"/>
                            <field name="supplier_invoice_numbers"/>
                            <field name="registered"/>
                            <field name="invoices_total"/>
                        </group>
                        <group attrs="{'invisible':[('ddt_number','=', '')]}">
                            <button name="action_view_delivery" string="View Delivery Order" type="object" attrs="{'invisible': [('ddt_number','=', '')]}" icon="gtk-zoom-fit"/>
                            <field name="ddt_number" nolabel="1"/>

                        </group>
                    </group>

                    <notebook>
                        <page string="Invoices">
                            <field name="in_invoice_ids" nolabel="1" context="{'form_view_ref': 'account.invoice_supplier_form', 'tree_view_ref': 'account.invoice_tree'}">
                                <tree>
                                    <field name="partner_id"/>
                                    <field name="date_invoice"/>
                                    <field name="reference"/>
                                    <field name="origin"/>
                                    <field name="amount_total"/>
                                    <field name="state"/>
                                    <!--<button name="remove_attachment_link" type="object" string="Remove" />-->
                                </tree>
                            </field>
                            <group groups="base.group_no_one" string="History">
                                <field name="create_uid" readonly="1"/>
                                <field name="create_date" readonly="1"/>
                            </group>
                        </page>
                        <page string="Invoice Preview" >
                            <group col="2" colspan="2">
                                <field name="xml_preview" widget="text_WYSIWYG" nolabel="1" readonly="1"/>
                                <newline/>
                                <field name="xml_attachment_datas" nolabel="1" readonly="1" filename="xml_attachment_filename" attrs="{'invisible': [('xml_have_attachment','=', False)]}"/>
                                <field name="xml_attachment_filename" invisible="1"/>
                                <field name="xml_have_attachment" invisible="1"/>
                            </group>
                        </page>
                        <page string="Errors">
                            <field name="xml_errors" nolabel="1"/>
                        </page>

                    </notebook>

                </form>
            </field>
        </record>

        <record id="view_fatturapa_in_attachment_tree" model="ir.ui.view">
            <field name="name">fatturapa.attachment.in.tree</field>
            <field name="model">fatturapa.attachment.in</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree colors="blue: registered == False; black: registered == True"  string="Xml Attachment">
                    <field name="name"/>
                    <field name="xml_invoice_type" />
                    <field name="xml_supplier_id"/>
                    <field name="supplier_invoice_numbers" />
                    <field name="invoices_date" />
                    <button name="action_view_delivery" string="View Delivery Order" type="object" attrs="{'invisible': [('ddt_number','=', '')]}" icon="gtk-zoom-fit"/>
                    <field name="ddt_number"/>
                    <field name="ddt_match"/>
                    <field name="invoices_total" sum="invoice_total"/>
                    <field name="ddt_match_invoices_total" sum="ddt_total"/>
                    <field name="invoice_total_difference_ddt" />
                    <button name="action_create_delivery_invoice" string="Create Directly Invoice" type="object" attrs="{'invisible': [('ddt_number','=', '')]}" icon="gtk-fullscreen"/>
                    <field name="registered" invisible="1" />
                    <field name="invoices_number"/>
	                <field name="in_invoice_ids"/>
                    <field name="sdi_id"/>
                    <field name="sdi_date"/>
                    <field name="xml_have_attachment" invisible="1" />
                    <!--<button name="get_attachment" string="Create Zip of Attachment" type="object" icon="terp-gtk-select-all" attrs="{'invisible': [('xml_have_attachment','=', False)]}"/>-->
                    <field name="xml_attachment_datas" filename="xml_attachment_filename"  attrs="{'invisible': [('xml_have_attachment','=', False)]}"/>
                    <field name="xml_attachment_filename" invisible="1"/>
                    <button name="dummy_button" icon="gtk-refresh" type="object" help="Reload Value" attrs="{'invisible': [('xml_supplier_id', '=', False)]}"/>
                </tree>
            </field>
        </record>

	    <record id="view_fatturapa_in_attachment_search" model="ir.ui.view">
	        <field name="name">fatturapa.attachment.in.search</field>
	        <field name="model">fatturapa.attachment.in</field>
	        <field name="type">search</field>
            <field name="arch" type="xml">
	            <search>
	                <field name="name"/>
	                <filter name="to_register" string="To Register" domain="[('in_invoice_ids', '=', False)]"/>
                    <field name="xml_supplier_id" domain="[('supplier', '=', True)]"/>
                    <field name="supplier_invoice_numbers" />
                    <field name="ddt_number" />
                    <field name="invoices_total" />
                    <separator orientation="vertical"/>
                    <field name="date_from" filter_domain="[('sdi_date','&gt;=',self)]"/>
                    <field name="date_to" filter_domain="[('sdi_date','&lt;=',self)]"/>
                    <separator orientation="vertical"/>
                    <filter icon="terp-go-month"
                        string="Last Month"
                        name="last_month"
                        domain="[
                            ('sdi_date', '&lt;', datetime.date.today().strftime('%%Y-%%m-01 00:00:00')),
                            ('sdi_date', '&gt;=', (datetime.date.today() - relativedelta(months=1)).strftime('%%Y-%%m-01 00:00:00'))
                        ]"
                    />
                    <filter icon="terp-go-month"
                        string="Current Month"
                        name="current_month"
                        domain="[
                            ('sdi_date', '&lt;', (datetime.date.today() + relativedelta(months=1)).strftime('%%Y-%%m-01 00:00:00')),
                            ('sdi_date', '&gt;=', (datetime.date.today()).strftime('%%Y-%%m-01 00:00:00'))
                        ]"
                    />

	            </search>
	        </field>
	    </record>

	    <record id="action_fattura_pa_in" model="ir.actions.act_window">
	        <field name="name">Incoming fatturaPA files</field>
	        <field name="res_model">fatturapa.attachment.in</field>
	        <field name="view_type">form</field>
	        <field name="view_mode">tree,form</field>
            <field name="limit">20</field>
            <field name="context">{'noduplicate': '1', 'nodelete': '1', 'search_default_to_register': True}</field>
