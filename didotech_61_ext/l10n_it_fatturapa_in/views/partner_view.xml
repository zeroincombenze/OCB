<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <record id="view_partner_form_fatturapa_in" model="ir.ui.view">
            <field name="name">partner.form.fatturapa.in</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="l10n_it_fatturapa.view_partner_form_fatturapa"/>
            <field name="arch" type="xml">
                <group name="fatturapa_group" position="after">
                    <group attrs="{'invisible':[('supplier','=',False)]}" col="4" colspan="4" string="FatturaPA Registration">
                        <group col="2">
                            <field name="e_invoice_detail_level"/>
                            <field name="e_invoice_default_product_id"/>
                            <field name="e_invoice_default_account_id" />
                            <field name="register"/>
                            <field name="register_code"/>
                            <field name="register_fiscalpos"/>
                        </group>
                        <group col="2">
                            <field name="register_province"/>
                            <field name="register_regdate"/>
                        </group>
                    </group>
                </group>
            </field>
        </record>
    </data>
</openerp>
