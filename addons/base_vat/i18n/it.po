#, python-format
msgid ""
"The VAT number [%s] for partner [%s] does not seem to be valid. \n"
"Note: the expected format is %s"
msgstr ""
"La P.IVA [%s] del partner [%s] non sembra valida. \n"
"Nota: il formato atteso è %s"

#. module: base_vat
#: code:addons/base_vat/models/res_partner.py:130
#: code:addons/base_vat/models/res_partner.py:130
#: code:addons/base_vat/models/res_partner.py:130
#, python-format
msgid ""
"The VAT number [%s] for partner [%s] either failed the VIES VAT "
"validation check or did not respect the expected format %s."
msgstr ""
"La P.IVA [%s] del partner [%s] ha fallito la validazione VIES(sistema "
"elettronico scambio dati IVA), oppure non è nel formato atteso %s."

