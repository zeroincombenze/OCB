"\n"
"                          LOSS    GAIN\n"
"  Revaluation account    [7700]  [7700]\n"
"  Provision B.S account  [    ]  [    ]\n"
"  Provision P&L account  [    ]  [    ]\n"
"\n"
"For CH (Provision)\n"
"------------------\n"
"(l10n_ch Chart of account)\n"
"\n"
"::\n"
